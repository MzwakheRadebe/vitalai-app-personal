# ============================================================
# VitalAI – Environment Variables Template
# Copy this file to .env and fill in your own values.
# NEVER commit your actual .env file to git.
# ============================================================

# App
ENV=development
PORT=8000
TZ=Africa/Johannesburg

# Security (generate strong random values for production)
# Run: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-random-secret
ENCRYPTION_KEY=replace-with-base64-32byte-key

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=your-supabase-anon-public-key

# AI Service (OpenAI or compatible — optional)
AI_SERVICE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=your-openai-api-key

# Local trained ML triage model (your team's model in ai_and_nlp/)
# Start it with: cd ai_and_nlp && python non_final_draft.py
ML_MODEL_URL=http://localhost:5000

# CORS (set to your frontend URL in production)
ALLOWED_ORIGINS=http://localhost:3000

# SQLite (local development only — not used in production)
SQLITE_PATH=./local_offline.db
